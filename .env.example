# 复制为 .env 后按需修改，用于登录页账号密码配置
# docker compose 会通过 env_file 把这些变量注入后端容器

# 登录用户名
BILL_AUTH_USERNAME=admin

# 登录密码（生产环境请务必修改为强密码）
BILL_AUTH_PASSWORD=change-me-please

# 服务器端“可视化选择文件 / 填路径读取源文件”功能的浏览根目录（容器内路径）
# 不设置时默认等于 BILL_DATA_DIR；如需指向单独的源日志目录，
# 记得同时在 docker-compose.yml 的 volumes 里挂载该目录
# BILL_BROWSE_ROOT=/app/source-logs

# 可选：业务数据库（options 表）连接信息，用于「模型单价来源」选择「数据库实时价格」
# 不设置 BILL_DB_HOST 时该功能不可用（前端仍可选内置官方价 / 报价表 xlsx）
# 强烈建议使用只读账号
# 页面点「拉取最新数据库价格」时才会连接数据库，结果落盘到 data/db_price_cache.json，
# 之后出账直接读该文件，不会常驻内存也不会每次都连数据库
#
# 同一套连接信息也用于「导出日志明细」——按时间段 + 客户账号从 logs 表直接把消费日志
# 导出成 tsv，替代人工在服务器上跑 mysql -e "SELECT ..." > xxx.tsv。
# 该功能只读，不会写业务库；单次导出跨度上限 92 天。
# 注意：仅当日志落在 MySQL 时可用。若 new-api 配置了 LOG_SQL_DSN 指向
# ClickHouse / 独立日志库，本功能连不上日志表，请退回手动导出
# （clickhouse-client --query "..." --format TabSeparatedWithNames）。
# BILL_DB_HOST=127.0.0.1
# BILL_DB_PORT=3306
# BILL_DB_USER=readonly_user
# BILL_DB_PASSWORD=change-me-please
# BILL_DB_NAME=one_api
# BILL_DB_TABLE=options
# 消费日志表名，默认 logs。与 BILL_DB_TABLE（options 表）分开配置：
# 两者虽在同一实例，但表名语义不同，混用会在换库时互相牵连。
# BILL_DB_LOG_TABLE=logs

# 「渠道成本倍率维护」功能复用上面的 BILL_DB_*（只读 channels 表）与下面的
# BILL_PG_*（倍率存本地）。不需要额外配置。
# 注意：导出的日志必须含 channel_id 列才能估算成本——本工具的「导出日志明细」
# 会自动带上它（若业务库的 logs 表没有该列，导出会少这一列并提示）。

# 可选：本地 PostgreSQL 连接信息，用于「客户折扣核对」功能——按用户名/用户 ID 拉取分组倍率、
# 换算成折扣后存一份快照在这里；之后核对/复查只读这份本地数据，不会再连业务库。
# 与上面的 BILL_DB_* 是两个完全独立的数据库，这里只存 billtool 自己的数据。
# 不设置 BILL_PG_HOST 时该功能不可用。docker-compose 里默认起了一个 postgres 服务，
# BILL_PG_HOST 保持 postgres 即可；若接的是外部/托管 Postgres，改成对应地址并按需设置 BILL_PG_SSLMODE。
BILL_PG_HOST=postgres
BILL_PG_PORT=5432
BILL_PG_USER=billtool
BILL_PG_PASSWORD=change-me-please
BILL_PG_DBNAME=billtool
# BILL_PG_SSLMODE=disable

