# 复制为 .env 后按需修改，用于登录页账号密码配置
# docker compose 会通过 env_file 把这些变量注入后端容器

# 登录用户名
BILL_AUTH_USERNAME=admin

# 登录密码（生产环境请务必修改为强密码）
BILL_AUTH_PASSWORD=change-me-please

# 服务器端“可视化选择文件 / 填路径读取源文件”功能的浏览根目录（容器内路径）
# 不设置时默认等于 BILL_DATA_DIR；如需指向单独的源日志目录，
# 记得同时在 docker-compose.yml 的 volumes 里挂载该目录
# BILL_BROWSE_ROOT=/app/source-logs

# 可选：业务数据库（options 表）连接信息，用于「模型单价来源」选择「数据库实时价格」
# 不设置 BILL_DB_HOST 时该功能不可用（前端仍可选内置官方价 / 报价表 xlsx）
# 强烈建议使用只读账号
# BILL_DB_HOST=127.0.0.1
# BILL_DB_PORT=3306
# BILL_DB_USER=readonly_user
# BILL_DB_PASSWORD=change-me-please
# BILL_DB_NAME=one_api
# BILL_DB_TABLE=options

